{
  "name": "RomaneioItem",
  "ui": { "label": "Romaneio - Item" },
  "fields": [
    { "name": "id", "type": "uuid", "id": true, "required": true, "ui": { "label": "ID" } },
    {
      "name": "romaneioId", "type": "reference", "required": true,
      "reference": { "target": "Romaneio", "onDelete": "cascade" },
      "ui": { "label": "Romaneio" }
    },
    {
      "name": "produtoId", "type": "reference", "required": true,
      "reference": { "target": "Produto", "onDelete": "restrict" },
      "ui": { "label": "Produto" }
    },
    { "name": "quantidade", "type": "long", "required": true, "ui": { "label": "Quantidade" } }
  ],
  "access": {
    "write": "$user.roles.contains('ADMIN') || $user.roles.contains('WarehouseManager')"
  },
  "invariants": [
    { "name": "RomaneioItemQuantidadePositive", "type": "expression", "expr": "quantidade > 0" }
  ]
}
