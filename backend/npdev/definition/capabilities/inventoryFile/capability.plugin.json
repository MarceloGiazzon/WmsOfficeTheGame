{
  "$schema": "npdev/capability-plugin.schema.json",
  "packageFormatVersion": "1.0",
  "packageId": "wmsoffice-inventoryfile-java-source-package",
  "pluginId": "wmsoffice-inventoryfile-java-source-plugin",
  "displayName": "WmsOffice Inventory File Round-Trip Capability",
  "version": "1.0.0",
  "description": "Pure-Java generation of a blank physical-inventory count template and parsing of the completed count file, flagging quantity divergences.",
  "capability": "inventoryFile",
  "capabilityType": "InventoryFileCapability",
  "adapterId": "plugin:java-source",
  "runtimeRef": "inventoryFileJavaSourceHandler",
  "implementation": {
    "kind": "javaSource",
    "sourceRoot": "capabilities/inventoryFile/src/main/java",
    "mainClass": "com.wmsoffice.capabilities.inventory.InventoryFileCapability",
    "factory": { "kind": "defaultConstructor" }
  },
  "operationBindings": [
    {
      "operation": "gerarTemplate", "method": "gerarTemplate",
      "input": { "mode": "firstArgument", "expectedType": "java.util.Map" },
      "output": { "mode": "returnValue", "expectedType": "java.util.Map" }
    },
    {
      "operation": "importarContagem", "method": "importarContagem",
      "input": { "mode": "firstArgument", "expectedType": "java.util.Map" },
      "output": { "mode": "returnValue", "expectedType": "java.util.Map" }
    },
    {
      "operation": "analisarArquivoRecebimento", "method": "analisarArquivoRecebimento",
      "input": { "mode": "firstArgument", "expectedType": "java.util.Map" },
      "output": { "mode": "returnValue", "expectedType": "java.util.Map" }
    }
  ],
  "trust": { "mode": "artifact-local-source", "source": "external-artifact-bundle", "level": "developer-supplied" },
  "generation": { "mount": "compileIntoGeneratedApp", "emitManifestContribution": true, "emitPackageDescriptor": true, "emitBinding": true }
}
